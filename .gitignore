# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =============================================================================
# Secrets — NEVER commit
# =============================================================================
.env*
!.env.example

# =============================================================================
# Node / Next.js
# =============================================================================

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build output
/.next/
/out/
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# =============================================================================
# Python (data pipeline in scripts/)
# =============================================================================

# virtual environment
venv/

# compiled cache
__pycache__/
*.pyc
*.pyo
*.pyd

# distribution / build artifacts
dist/
*.egg-info/

# Yale vintage data — staged snapshots + merged/sorted parquet (large; lives in
# Supabase Storage, regenerated by the ingest/merge/prepare scripts, never committed)
/data/
*.parquet

# =============================================================================
# Editor / OS clutter
# =============================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# =============================================================================
# Misc
# =============================================================================
*.log
*.pem

# Sentry Config File
.env.sentry-build-plugin
